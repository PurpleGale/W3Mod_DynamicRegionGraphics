<?xml version="1.0" encoding="UTF-8"?>
<UserConfig>
    <!-- ================================================================= -->
    <!-- 1. GENERAL SETTINGS                                               -->
    <!-- ================================================================= -->
    <Group id="DynamicRegionGraphics_Main" displayName="Mods.DynamicRegionGraphics.DRG_General">
        <VisibleVars>
            <Var id="DRG_Enabled" displayName="DRG_Enabled" displayType="TOGGLE" tags="customDisplayName"/>
            <Var id="DRG_Notifications" displayName="DRG_Notifications" displayType="TOGGLE" tags="customDisplayName"/>
            <Var id="DRG_DisableInCombat" displayName="DRG_DisableInCombat" displayType="TOGGLE" tags="customDisplayName"/>

            <Var id="Separator_Upscale" displayName="" displayType="SUBTLE_SEPARATOR"/>

            <Var id="DRG_PT_UpscaleQuality" displayName="DRG_PT_UpscaleQuality" displayType="OPTIONS" tags="customNames;customDisplayName">
                <OptionsArray>
                    <Option id="0" displayName="DRG_Opt_Default"><Entry varId="DRG_PT_UpscaleQuality" value="0"/></Option>
                    <Option id="1" displayName="DRG_Upscale_Auto"><Entry varId="DRG_PT_UpscaleQuality" value="1"/></Option>
                    <Option id="2" displayName="DRG_Upscale_Quality"><Entry varId="DRG_PT_UpscaleQuality" value="2"/></Option>
                    <Option id="3" displayName="DRG_Upscale_Balanced"><Entry varId="DRG_PT_UpscaleQuality" value="3"/></Option>
                    <Option id="4" displayName="DRG_Upscale_Perf"><Entry varId="DRG_PT_UpscaleQuality" value="4"/></Option>
                    <Option id="5" displayName="DRG_Upscale_UltraPerf"><Entry varId="DRG_PT_UpscaleQuality" value="5"/></Option>
                </OptionsArray>
            </Var>
            <Var id="DRG_RT_UpscaleQuality" displayName="DRG_RT_UpscaleQuality" displayType="OPTIONS" tags="customNames;customDisplayName">
                <OptionsArray>
                    <Option id="0" displayName="DRG_Opt_Default"><Entry varId="DRG_RT_UpscaleQuality" value="0"/></Option>
                    <Option id="1" displayName="DRG_Upscale_Auto"><Entry varId="DRG_RT_UpscaleQuality" value="1"/></Option>
                    <Option id="2" displayName="DRG_Upscale_Quality"><Entry varId="DRG_RT_UpscaleQuality" value="2"/></Option>
                    <Option id="3" displayName="DRG_Upscale_Balanced"><Entry varId="DRG_RT_UpscaleQuality" value="3"/></Option>
                    <Option id="4" displayName="DRG_Upscale_Perf"><Entry varId="DRG_RT_UpscaleQuality" value="4"/></Option>
                    <Option id="5" displayName="DRG_Upscale_UltraPerf"><Entry varId="DRG_RT_UpscaleQuality" value="5"/></Option>
                </OptionsArray>
            </Var>

            <Var id="Separator_RT" displayName="" displayType="SUBTLE_SEPARATOR"/>

            <!-- Ray Tracing Quality Options (applied when RT is active in regions) -->
            <Var id="DRG_RT_GI" displayName="option_rt_global_illumination" displayType="OPTIONS" tags="customNames;customDisplayName">
                <OptionsArray>
                    <Option id="0" displayName="dlss_perf"><Entry varId="DRG_RT_GI" value="0"/></Option>
                    <Option id="1" displayName="dlss_quality"><Entry varId="DRG_RT_GI" value="1"/></Option>
                </OptionsArray>
            </Var>

            <Var id="DRG_RT_Reflections" displayName="enable_rt_radiance" displayType="TOGGLE" tags="customDisplayName"/>

            <Var id="DRG_RT_Shadows" displayName="enable_rt_shadows" displayType="OPTIONS" tags="customNames;customDisplayName">
                <OptionsArray>
                    <Option id="0" displayName="panel_mainmenu_option_value_off"><Entry varId="DRG_RT_Shadows" value="0"/></Option>
                    <Option id="1" displayName="dlss_perf"><Entry varId="DRG_RT_Shadows" value="1"/></Option>
                    <Option id="2" displayName="dlss_quality"><Entry varId="DRG_RT_Shadows" value="2"/></Option>
                </OptionsArray>
            </Var>

            <Var id="DRG_RT_AO" displayName="option_rt_ambient_occlusion" displayType="TOGGLE" tags="customDisplayName"/>
        </VisibleVars>
    </Group>

