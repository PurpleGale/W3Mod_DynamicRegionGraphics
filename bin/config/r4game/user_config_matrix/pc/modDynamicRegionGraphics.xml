                    <Option id="0" displayName="DRG_Opt_Default"><Entry varId="DRG_Wyzima_Int" value="0"/></Option>
                    <Option id="1" displayName="DRG_Opt_RT"><Entry varId="DRG_Wyzima_Int" value="1"/></Option>
                    <Option id="2" displayName="DRG_Opt_PT"><Entry varId="DRG_Wyzima_Int" value="2"/></Option>
                </OptionsArray>
            </Var>
            <Var id="DRG_Wyzima_Ext" displayName="DRG_Exterior" displayType="OPTIONS" tags="customNames;customDisplayName">
                <OptionsArray>
                    <Option id="0" displayName="DRG_Opt_Default"><Entry varId="DRG_Wyzima_Ext" value="0"/></Option>
                    <Option id="1" displayName="DRG_Opt_RT"><Entry varId="DRG_Wyzima_Ext" value="1"/></Option>
                    <Option id="2" displayName="DRG_Opt_PT"><Entry varId="DRG_Wyzima_Ext" value="2"/></Option>
                </OptionsArray>
            </Var>
        </VisibleVars>
    </Group>

