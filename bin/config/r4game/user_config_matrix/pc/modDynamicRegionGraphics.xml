<?xml version="1.0" encoding="UTF-8"?>
<UserConfig>
    <!-- ================================================================= -->
    <!-- 1. GENERAL SETTINGS                                               -->
    <!-- ================================================================= -->
    <Group id="DynamicRegionGraphics_Main" displayName="Mods.DynamicRegionGraphics.DRG_General">
        <VisibleVars>
            <Var id="DRG_Enabled" displayName="DRG_Enabled" displayType="TOGGLE" tags="customDisplayName"/>
            <Var id="DRG_Notifications" displayName="DRG_Notifications" displayType="TOGGLE" tags="customDisplayName"/>
            <Var id="DRG_DisableInCombat" displayName="DRG_DisableInCombat" displayType="TOGGLE" tags="customDisplayName"/>

            <Var id="Separator_Upscale" displayName="" displayType="SUBTLE_SEPARATOR"/>

            <!-- Override Anti-Aliasing Switch Button -->
            <Var id="DRG_OverrideAA" displayName="DRG_OverrideAA" displayType="TOGGLE" tags="customDisplayName"/>

            <!-- Anti-Aliasing Mode (Active only when Override AA is enabled) -->
            <Var id="DRG_AAMode" displayName="allow_Antialias" displayType="OPTIONS" tags="customNames;indent">
                <OptionsArray>
                    <Option id="0" displayName="panel_mainmenu_option_value_off">
                        <Entry varId="DRG_AAMode" value="0"/>
                    </Option>
                    <Option id="1" displayName="DRG_AA_FXAA">
                        <Entry varId="DRG_AAMode" value="1"/>
                    </Option>
                    <Option id="2" displayName="DRG_AA_FSR">
                        <Entry varId="DRG_AAMode" value="5"/>
                    </Option>
                    <Option id="3" displayName="DRG_AA_XeSS">
                        <Entry varId="DRG_AAMode" value="7"/>
                    </Option>
                    <Option id="4" displayName="DRG_AA_DLSS">
                        <Entry varId="DRG_AAMode" value="6"/>
                    </Option>
                </OptionsArray>
            </Var>

            <!-- DLSS Quality (Includes DLAA) -->
            <Var id="DRG_DLSSQuality" displayName="dlss_quality" displayType="OPTIONS" tags="customNames;indent">
                <OptionsArray>
                    <Option id="0" displayName="dlss_auto">
                        <Entry varId="DRG_DLSSQuality" value="0"/>
                    </Option>
                    <Option id="1" displayName="dlss_quality">
                        <Entry varId="DRG_DLSSQuality" value="1"/>
                    </Option>
                    <Option id="2" displayName="dlss_balanced">
                        <Entry varId="DRG_DLSSQuality" value="2"/>
                    </Option>
                    <Option id="3" displayName="dlss_perf">
                        <Entry varId="DRG_DLSSQuality" value="3"/>
                    </Option>
                    <Option id="4" displayName="dlss_ultraperf">
                        <Entry varId="DRG_DLSSQuality" value="4"/>
                    </Option>
                    <Option id="5" displayName="option_dlss_dlaa">
                        <Entry varId="DRG_DLSSQuality" value="5"/>
                    </Option>
                </OptionsArray>
            </Var>

            <!-- DLSS Ray Reconstruction -->
            <Var id="DRG_EnableDLSSRR" displayName="dlss_r" displayType="TOGGLE" tags="customNames;indent;enableIfDLSSRRSupported"/>

            <!-- AMD FSR Quality -->
            <Var id="DRG_FSR2Quality" displayName="fsr_quality" displayType="OPTIONS" tags="customNames;indent">
                <OptionsArray>
                    <Option id="0" displayName="dlss_auto">
                        <Entry varId="DRG_FSR2Quality" value="0"/>
                    </Option>
                    <Option id="1" displayName="option_nativeaa" tags="enableIfFSR4">
                        <Entry varId="DRG_FSR2Quality" value="1"/>
                    </Option>
                    <Option id="2" displayName="dlss_quality">
                        <Entry varId="DRG_FSR2Quality" value="2"/>
                    </Option>
                    <Option id="3" displayName="dlss_balanced">
                        <Entry varId="DRG_FSR2Quality" value="3"/>
                    </Option>
                    <Option id="4" displayName="dlss_perf">
                        <Entry varId="DRG_FSR2Quality" value="4"/>
                    </Option>
                    <Option id="5" displayName="dlss_ultraperf">
                        <Entry varId="DRG_FSR2Quality" value="5"/>
                    </Option>
                </OptionsArray>
            </Var>

            <!-- XeSS Quality -->
            <Var id="DRG_XESSQuality" displayName="xess_quality" displayType="OPTIONS" tags="customNames;indent">
                <OptionsArray>
                    <Option id="0" displayName="dlss_auto">
                        <Entry varId="DRG_XESSQuality" value="0"/>
                    </Option>
                    <Option id="1" displayName="option_nativeaa">
                        <Entry varId="DRG_XESSQuality" value="1"/>
                    </Option>
                    <Option id="2" displayName="option_xess_ultra_quality_plus">
                        <Entry varId="DRG_XESSQuality" value="2"/>
                    </Option>
                    <Option id="3" displayName="xess_ultraquality">
                        <Entry varId="DRG_XESSQuality" value="3"/>
                    </Option>
                    <Option id="4" displayName="dlss_quality">
                        <Entry varId="DRG_XESSQuality" value="4"/>
                    </Option>
                    <Option id="5" displayName="dlss_balanced">
                        <Entry varId="DRG_XESSQuality" value="5"/>
                    </Option>
                    <Option id="6" displayName="dlss_perf">
                        <Entry varId="DRG_XESSQuality" value="6"/>
                    </Option>
                    <Option id="7" displayName="dlss_ultraperf">
                        <Entry varId="DRG_XESSQuality" value="7"/>
                    </Option>
                </OptionsArray>
            </Var>

            <!-- Dynamic Resolution Scaling -->
            <Var id="DRG_DRSEnable" displayName="DynamicResolutionScaling" displayType="OPTIONS" tags="customNames;customDisplayName;indent">
                <OptionsArray>
                    <Option id="0" displayName="panel_mainmenu_option_value_off">
                        <Entry varId="DRG_DRSEnable" value="false"/>
                    </Option>
                    <Option id="1" displayName="panel_mainmenu_option_value_on">
                        <Entry varId="DRG_DRSEnable" value="true"/>
                    </Option>
                </OptionsArray>
            </Var>

            <Var id="Separator_RT" displayName="" displayType="SUBTLE_SEPARATOR"/>

            <!-- Ray Tracing Quality Options (applied when RT is active in regions) -->
            <Var id="DRG_RT_GI" displayName="option_rt_global_illumination" displayType="OPTIONS" tags="customNames;customDisplayName">
                <OptionsArray>
                    <Option id="0" displayName="dlss_perf"><Entry varId="DRG_RT_GI" value="0"/></Option>
                    <Option id="1" displayName="dlss_quality"><Entry varId="DRG_RT_GI" value="1"/></Option>
                </OptionsArray>
            </Var>

            <Var id="DRG_RT_Reflections" displayName="enable_rt_radiance" displayType="TOGGLE" tags="customDisplayName"/>

            <Var id="DRG_RT_Shadows" displayName="enable_rt_shadows" displayType="OPTIONS" tags="customNames;customDisplayName">
                <OptionsArray>
                    <Option id="0" displayName="panel_mainmenu_option_value_off"><Entry varId="DRG_RT_Shadows" value="0"/></Option>
                    <Option id="1" displayName="dlss_perf"><Entry varId="DRG_RT_Shadows" value="1"/></Option>
                    <Option id="2" displayName="dlss_quality"><Entry varId="DRG_RT_Shadows" value="2"/></Option>
                </OptionsArray>
            </Var>

            <Var id="DRG_RT_AO" displayName="option_rt_ambient_occlusion" displayType="TOGGLE" tags="customDisplayName"/>
        </VisibleVars>
    </Group>

    <!-- ================================================================= -->
